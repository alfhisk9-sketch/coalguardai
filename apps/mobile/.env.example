# Expo public config — these are the same public Supabase values the web app uses.
# NEVER put SUPABASE_SERVICE_ROLE_KEY in a mobile app; it would ship to every device.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
EXPO_PUBLIC_API_BASE_URL=https://your-web-deployment.example.com
