# =====================================================================
# COALGUARD AI — ENVIRONMENT VARIABLES SPECIFICATION
# Safer Mines — Smarter Governance
# =====================================================================
# Copy this file to .env.local for development.
# NEVER commit .env.local, .env.production, or any real secrets to git.

# ---------------------------------------------------------------------
# 1. Supabase PostgreSQL & GoTrue Auth (Remote Source of Truth)
# ---------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ---------------------------------------------------------------------
# 2. Google Gemini AI API (Server-side Only)
# ---------------------------------------------------------------------
GEMINI_API_KEY=your-google-gemini-api-key-here
GEMINI_ENABLED=true
GEMINI_MODEL=gemini-flash-latest

# ---------------------------------------------------------------------
# 3. Application State & Environment
# ---------------------------------------------------------------------
APP_ENV=development
DATA_MODE=demo
NEXT_PUBLIC_DEMO_MODE=true

# ---------------------------------------------------------------------
# 4. Service & Deployment Configuration
# ---------------------------------------------------------------------
PORT=3000
SESSION_SECRET=your-session-secret-key-here
FRONTEND_URL=http://localhost:3000
