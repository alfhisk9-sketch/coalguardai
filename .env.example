# Copy to .env.local and fill in real values. NEVER commit .env.local.

# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Account 3 (AI) — Gemini
GEMINI_API_KEY=your-gemini-api-key-here

# Optional (Account 2): enables the demo session + role switcher described in
# docs/C2_HANDOFF.md. Does NOT fake API data and is not a security boundary.
NEXT_PUBLIC_DEMO_MODE=false
